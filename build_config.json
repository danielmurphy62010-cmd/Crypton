{
  "module_name": "backend",
  "sources": ["backend.cpp"],
  "build_dependencies": ["setuptools>=68", "wheel>=0.43", "pybind11>=2.13.6"],
  "cxx_standard": 17,
  "windows_libraries": ["ws2_32", "bcrypt"],
  "unix_libraries": [],
  "compiler_args": {
    "msvc": ["/W4", "/EHsc"],
    "unix": ["-Wall", "-Wextra", "-Wpedantic"]
  },
  "artifacts": {
    "windows_pattern": "backend*.pyd",
    "linux_pattern": "backend*.so",
    "name": "backend-compiled"
  }
}
